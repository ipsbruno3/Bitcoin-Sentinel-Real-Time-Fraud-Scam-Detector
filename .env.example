# Copy this file to .env and fill in your credentials
# .env is gitignored — never commit your actual credentials

# Etherscan API key — free at https://etherscan.io/myapikey
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_API_KEY

# Webshare rotating proxy URL
# Format: http://user:password@p.webshare.io:80/
WEBSHARE_PROXY_URL=http://YOUR_USER:YOUR_PASSWORD@p.webshare.io:80/
